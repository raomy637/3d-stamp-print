base_t       = is_undef(base_t)       ? 3.0     : base_t;
relief       = is_undef(relief)       ? 1.8     : relief;
overlap      = is_undef(overlap)      ? 0.05    : overlap;
draft_ratio  = is_undef(draft_ratio)  ? 1.0     : draft_ratio;   // 槽顶 / 槽底

module base_body() {
    if (mode == "sink") {
        // 凹模：图案从顶面向下挖 relief 深；槽底窄、开口宽（外张锥度）
